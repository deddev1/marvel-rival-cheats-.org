---
import { marvelRivalsImages } from '../data/marvel-rivals';
import { getUi } from '../data/i18n';
import { getGalleryUi } from '../data/i18n/gallery-ui';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const gallery = getGalleryUi(locale);

const galleryAlts = [
	ui.images.hacksPackage,
	ui.images.espWallhack,
	ui.images.aimbotCombat,
	ui.images.headerArt,
	ui.images.packFight,
	ui.images.dinoEsp,
] as const;

const galleryImages = marvelRivalsImages.gallery.map((image, index) => ({
	src: image.src,
	alt: galleryAlts[index] ?? image.alt,
	featured: image.featured === true,
}));
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<h2 id="gallery-title" class="gallery__title">{gallery.title}</h2>
	<p class="gallery__sub">{gallery.subtitle}</p>

	<div class="gallery__track" role="list">
		{
			galleryImages.map((image) => (
				<figure class:list={['gallery__item', 'media-frame', image.featured && 'is-featured']} role="listitem">
					<img
						src={image.src}
						srcset={contentSrcSet(image.src)}
						sizes={galleryTileSizes}
						alt={image.alt}
						width="640"
						height="400"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			))
		}
	</div>
</section>

<style>
	.gallery__title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.gallery__sub {
		margin: 0.5rem 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
		line-height: 1.5;
		max-width: 36rem;
	}

	.gallery__track {
		display: flex;
		gap: 0.75rem;
		overflow-x: auto;
		padding-bottom: 0.35rem;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
	}

	.gallery__item {
		margin: 0;
		flex: 0 0 min(78vw, 320px);
		aspect-ratio: 16 / 10;
		scroll-snap-align: start;
	}

	.gallery__item.is-featured {
		flex-basis: min(88vw, 420px);
	}

	@media (min-width: 900px) {
		.gallery__item {
			flex-basis: 280px;
		}

		.gallery__item.is-featured {
			flex-basis: 360px;
		}
	}
</style>
