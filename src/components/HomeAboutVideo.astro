---
/** Homepage preview — poster only until click; no MP4 download on initial page load. */
const PREVIEW_VIDEO_SRC =
	'https://ooszazcwzmwhitdxwtom.supabase.co/storage/v1/object/public/ef/0510%282%29.mp4';
const PREVIEW_POSTER = '/images/marvel-rivals-preview-video-poster-640w.webp';
---

<div class="home__about-media" data-home-video>
	<video
		class="home__about-video"
		width={640}
		height={360}
		playsinline
		preload="none"
		poster={PREVIEW_POSTER}
		data-src={PREVIEW_VIDEO_SRC}
	>
		Your browser does not support embedded video playback.
	</video>
	<button
		type="button"
		class="home__about-video-play"
		data-home-video-play
		aria-label="Play Marvel Rivals Cheats preview video"
	>
		<span class="home__about-video-play-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none">
				<path
					d="M8 5.8v12.4L19 12 8 5.8z"
					fill="currentColor"
					stroke="currentColor"
					stroke-width="1.2"
					stroke-linejoin="round"></path>
			</svg>
		</span>
		<span class="home__about-video-play-label">Watch preview</span>
	</button>
	<p class="home__about-video-loading" data-home-video-loading hidden>Loading preview…</p>
	<p class="home__about-video-error" data-home-video-error hidden role="status">
		Video could not load.{' '}
		<a href={PREVIEW_VIDEO_SRC} target="_blank" rel="noopener noreferrer">Open in new tab</a>
	</p>
</div>

<script is:inline src="/scripts/home-about-video.js" defer></script>
