---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeAboutApp from '../components/react/HomeAbout';
import HomeAboutGallery from '../components/HomeAboutGallery.astro';
import ExternalResources from '../components/ExternalResources.astro';
import { externalUrls } from '../data/external-resources';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, productInfo, siteConfig, customerReviewStats } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';
import { defaultCrawlImageSrc } from '../data/page-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
/** Canonical product entity — always the English money URL, even on locale home pages. */
const canonicalProductUrl = new URL('/', siteConfig.url).href;
const heroImage = new URL(siteConfig.defaultOgImage || defaultCrawlImageSrc, siteConfig.url).href;
const priceValidUntil = '2027-12-31';

const aggregateRating = {
	'@type': 'AggregateRating',
	ratingValue: customerReviewStats.averageRating.toFixed(1),
	reviewCount: String(customerReviewStats.totalCount),
	bestRating: '5',
	worstRating: '1',
};

/** One commerce type only — Product. Reviews live on /reviews/. */
const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Product',
		'@id': `${canonicalProductUrl}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: canonicalProductUrl,
		aggregateRating,
		offers: {
			'@type': 'AggregateOffer',
			lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2),
			highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2),
			priceCurrency: productInfo.currency,
			offerCount: productInfo.plans.length,
			availability: 'https://schema.org/InStock',
			url: siteConfig.checkoutUrl,
			offers: productInfo.plans.map((plan) => ({
				'@type': 'Offer',
				name: `${productInfo.name} ${plan.label}`,
				price: plan.price.toFixed(2),
				priceCurrency: productInfo.currency,
				priceValidUntil,
				availability: 'https://schema.org/InStock',
				url: siteConfig.checkoutUrl,
				seller: { '@id': `${siteConfig.url}/#organization` },
			})),
		},
	},
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		mainEntity: homeFaqs.map((item) => ({
			'@type': 'Question',
			name: item.question,
			url: `${siteConfig.url}/faq/${item.slug}/`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={
		home.imageAlt?.trim() && home.imageAlt.trim().length > 12
			? home.imageAlt
			: `${siteConfig.name} — The Marvel Rivals ESP and aimbot`
	}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={locale === 'en' ? extraGraph : extraGraph.filter((n) => n['@type'] !== 'FAQPage')}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<HomeReviews locale={locale} />
		<div class="home__seo">
			{
				locale === 'en' ? (
					<>
						<section class="shell home__prose home__prose--en" aria-labelledby="home-about-title">
							<div class="home__about-grid">
								<HomeAboutApp client:visible locale={locale} />
								<HomeAboutGallery />
							</div>
						</section>
						<HomeSeo locale={locale} />
						<div class="shell">
							<ExternalResources locale={locale} omitHrefs={[externalUrls.wiki]} />
						</div>
					</>
				) : (
					<div class="shell home__prose">
						<h2>{home.h1}</h2>
						<p>{home.intro}</p>
						{
							home.sections.map((section) => (
								<div>
									<h3>{section.h2}</h3>
									{section.paragraphs.map((p) => (
										<p set:html={p} />
									))}
								</div>
							))
						}
					</div>
				)
			}
		</div>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line-soft);
		background: var(--bg-panel);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.home__prose {
		padding-block: var(--section-space);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__prose-callout {
		max-width: none;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__prose--en a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--ink);
	}

	.home__prose h1,
	.home__prose h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.home__prose h3 {
		margin: 1.25rem 0 0.5rem;
		font-size: 1rem;
		color: var(--ink);
	}
</style>

<style is:global>
	/* HomeAbout is React-rendered — scoped Astro styles do not reach it. */
	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 340px);
		gap: clamp(1rem, 2.5vw, 1.75rem);
		align-items: center;
	}

	.home__about-showcase {
		display: grid;
		gap: 0.5rem;
		width: 100%;
		max-width: 340px;
		margin-inline: auto;
	}

	.home__about-featured {
		margin: 0;
		aspect-ratio: 16 / 9;
		border-radius: calc(var(--radius-md) - 2px);
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--bg);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
	}

	.home__about-featured-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.home__about-scroll-wrap {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-sm);
	}

	.home__about-scroll-wrap::before,
	.home__about-scroll-wrap::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 0.85rem;
		z-index: 1;
		pointer-events: none;
	}

	.home__about-scroll-wrap::before {
		left: 0;
		background: linear-gradient(90deg, var(--bg-panel), transparent);
	}

	.home__about-scroll-wrap::after {
		right: 0;
		background: linear-gradient(270deg, var(--bg-panel), transparent);
	}

	.home__about-scroll {
		display: flex;
		gap: 0.4rem;
		overflow-x: auto;
		padding: 0.1rem 0.05rem 0.2rem;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
	}

	.home__about-scroll::-webkit-scrollbar {
		height: 4px;
	}

	.home__about-thumb {
		flex: 0 0 auto;
		width: 5.75rem;
		padding: 0;
		border: 1.5px solid transparent;
		border-radius: calc(var(--radius-sm) - 3px);
		background: var(--bg);
		cursor: pointer;
		overflow: hidden;
		scroll-snap-align: start;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.home__about-thumb img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.home__about-thumb:hover {
		border-color: color-mix(in srgb, var(--magenta) 45%, var(--line));
	}

	.home__about-thumb.is-active {
		border-color: var(--magenta);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--magenta) 35%, transparent);
	}

	.home__about-thumb:focus-visible {
		outline: 2px solid var(--magenta);
		outline-offset: 2px;
	}

	@media (max-width: 860px) {
		.home__about-grid {
			grid-template-columns: 1fr;
		}

		.home__about-showcase {
			max-width: min(100%, 380px);
		}
	}

	.home__prose-callout {
		max-width: none;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__prose--en a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--ink);
	}
</style>
